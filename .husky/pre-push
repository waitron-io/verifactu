#!/usr/bin/env sh
set -eu

cd "$(git rev-parse --show-toplevel)"

saw_ref=0
has_update=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  saw_ref=1
  case "$local_sha" in
    *[!0]*) has_update=1 ;;
    *) continue ;;
  esac

  # A new branch has no remote tip; use the default branch as its sign-off base.
  case "$remote_sha" in
    *[!0]*) base="$remote_sha" ;;
    *) base=$(git merge-base origin/main "$local_sha") || {
      echo "pre-push: cannot find origin/main; fetch origin before pushing" >&2
      exit 1
    } ;;
  esac

  commits=$(git rev-list "$base..$local_sha") || {
    echo "pre-push: cannot inspect the pushed commits; fetch origin before pushing" >&2
    exit 1
  }
  for commit in $commits; do
    if ! git log -1 --format=%B "$commit" | grep -qiE '^Signed-off-by: .+ <.+@.+>'; then
      echo "pre-push: commit $commit lacks a Signed-off-by trailer" >&2
      exit 1
    fi
  done
done

if [ "$saw_ref" -eq 1 ] && [ "$has_update" -eq 0 ]; then
  echo "pre-push: deletion only; checks skipped"
  exit 0
fi

run_step() {
  echo "pre-push: running $1"
  shift
  "$@" || {
    echo "pre-push: check failed" >&2
    exit 1
  }
}

run_step "locked install" npm ci
run_step "format check" npm run format:check
run_step "lint" npm run lint
run_step "typecheck" npm run typecheck
